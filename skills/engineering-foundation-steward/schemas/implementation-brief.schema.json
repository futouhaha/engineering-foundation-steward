{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "engineering.implementation-brief/v2"
    },
    "brief_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "proposal_only"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "baseline_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "reuse_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "target_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1
          },
          "expected_effect": {
            "type": "string",
            "minLength": 1
          },
          "side_effects": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "rollback": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "action",
          "expected_effect",
          "side_effects",
          "verification",
          "rollback"
        ]
      },
      "minItems": 0
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "review_rule": {
      "type": "string",
      "minLength": 1
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "approval_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "post_apply_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "next_recheck": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "brief_id",
    "project_id",
    "status",
    "objective",
    "baseline_refs",
    "reuse_refs",
    "target_paths",
    "changes",
    "out_of_scope",
    "author",
    "review_rule",
    "stop_conditions",
    "approval_questions",
    "post_apply_checks",
    "next_recheck"
  ]
}
